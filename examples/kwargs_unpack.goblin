# **-unpacking merges a dict into the call's keyword arguments. Keys must be
# strings, and a name that was already supplied is rejected — the same
# TypeError in both backends, catchable like any other error.
func show(**kwargs) {
    print(kwargs["color"], kwargs["size"], kwargs["weight"])
}

var defaults = {"color": "red", "size": 3}
show(**defaults, weight = 10)

# A ** parameter receives the keywords in the order the call gives them: a
# Dict's entries in its own order, explicit keywords where they are written,
# left to right. Parameters named by a keyword are bound, not collected.
func collect(first, **rest) {
    return rest
}
print(collect(1, zeta = 1, alpha = 2, mid = 3))
print(collect(1, **{"z": 1, "a": 2}, m = 3, **{"b": 4}))
print(collect(zeta = 1, first = 0, alpha = 2).keys())
var method_like = func(self, **opts) { return opts.keys() }
print(method_like(nil, y = 1, x = 2))
type Builder(name) {
    func with(self, **opts) {
        return "{self.name} {opts}"
    }
}
print(Builder("b").with(y = 1, x = 2))

# Explicit keyword first, then ** supplies the same name again.
try {
    show(color = "blue", **defaults)
} catch e {
    print(e.is(TypeError))
    print(e.message)
}

# Two ** dicts that share a key collide the same way.
try {
    show(**defaults, **{"size": 4})
} catch e {
    print(e.message)
}

# Keyword names must be strings.
try {
    show(**{1: "x"})
} catch e {
    print(e.message)
}

# A call may expand a list and a dict together: `*` supplies the positional
# arguments, then keywords and `**` follow it.
func place(x, y, z=0, **style) {
    return "{x},{y},{z} {style}"
}
var point = [1, 2]
var look = {"color": "red"}
print(place(*point, **look))
print(place(*point, z=3, **look))
print(place(*[1], y=5))
try {
    place(*point, x=9)
} catch e: TypeError {
    print(e.message)
}
