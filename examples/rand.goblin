import "rand"

print(type_of(rand.int()) == Int)
print(type_of(rand.int(100)) == Int)
print(type_of(rand.float()) == Float)
print(rand.int(1))

var first = rand.Rand(seed=42)
var second = rand.Rand(seed=42)
print(type_of(first) == rand.Rand)
print(first.int(1000) == second.int(1000))

var value = first.float()
print(value >= 0.0)
print(value < 1.0)

var values = [1, 2, 3]
first.shuffle(values)
print(values.size)
var indexes = first.perm(4)
indexes.sort()
print(indexes)

print(type_of(first.norm_float()) == Float)
print(first.exp_float() >= 0.0)
