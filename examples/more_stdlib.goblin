import "hmac"
import "crc64"
import "fnv"
import "lzw"
import "pem"
import "netip"
import "utf8"
import "unicode"

print(hmac.hex("key", "The quick brown fox jumps over the lazy dog"))
print(crc64.hex("123456789"))
print(fnv.hex("hello"))
print(lzw.decompress(lzw.compress("Goblin")))

var block = pem.Block("MESSAGE", "Goblin")
var decoded = pem.decode(block.encode())
print(decoded[0].label)
print(decoded[0].data)

var addr = netip.Addr("192.168.1.10")
var network = netip.Prefix("192.168.1.5/24")
print(addr.is_private)
print(network.masked())
print(network.contains(addr))

print(utf8.valid("Goblin 👺"))
print(utf8.rune_count("Goblin 👺"))
print(unicode.is_letter("界"))
