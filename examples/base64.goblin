import "base64"
import "fs"
import "json"

# Basic authentication
var user = "aladdin"
var password = "opensesame"
var credentials = base64.encode("{user}:{password}")
var headers = {"Authorization": "Basic {credentials}"}
print(headers["Authorization"])

# Binary data inside JSON, and back
var scratch = fs.mkdir_temp(prefix="goblin-base64-")
defer fs.remove(scratch, recursive=true)
var logo = scratch.join("logo.png")
fs.write(logo, Bytes([137, 80, 78, 71, 13, 10, 26, 10, 0, 255]))
var payload = json.marshal({"name": "logo.png", "data": base64.encode(fs.read_bytes(logo))})
print(payload)
var image = base64.decode(json.unmarshal(payload)["data"])
fs.write(scratch.join("logo-copy.png"), image)
print(fs.read_bytes(scratch.join("logo-copy.png")) == fs.read_bytes(logo))

# The middle part of a JWT: URL alphabet, no padding
var claims_text = `{"sub":"1234567890","name":"John Doe","admin":true}`
var token = "eyJhbGciOiJIUzI1NiJ9." + base64.encode(claims_text, url_safe=true, padding=false) + ".c2ln"
print(token)
var claims = json.unmarshal(base64.decode(token.split(".")[1], url_safe=true).decode())
print(claims["name"], claims["admin"])

# Alphabet and padding
print(base64.encode(Bytes([251, 255])), base64.encode(Bytes([251, 255]), url_safe=true))
print(base64.encode(Bytes([251, 255]), url_safe=true, padding=false))
print(base64.decode("+/8="), base64.decode("+/8"), base64.decode("-_8", url_safe=true))

# Line breaks are ignored; empty text is empty Bytes
print(base64.decode("aGVsbG8s\nIEdvYmxp\r\nbg==").decode())
print(base64.encode(""), base64.decode(""), base64.encode(Bytes("")) == "")

# A readable is read to its end
var file = fs.open(logo)
print(base64.encode(file))
file.close()

# Invalid text is a ParseError naming the character position
for text in ["aGVs!G8=", "QQ=", "-_8", "héllo"] {
    try {
        base64.decode(text)
    } catch e {
        print(e.is(ParseError), e)
    }
}
try {
    base64.decode(Bytes("QQ=="))
} catch e {
    print(e.is(TypeError), e)
}
