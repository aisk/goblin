import "base64"

var encoded = base64.encode("hello, Goblin")
print(encoded)
print(base64.decode(encoded).decode())

# The URL-safe alphabet and padding are independent keywords.
var url_encoded = base64.encode(Bytes([251, 255]), url=true, padding=false)
print(url_encoded)
print(base64.decode(url_encoded, url=true, padding=false))
print(base64.encode(Bytes([251, 255]), url=true))
