# Basic AND/OR
print(true && true)
print(true && false)
print(false || true)
print(false || false)

# NOT operator
print(!true)
print(!false)
print(!!true)
print(!!!true)

# Truthiness decides which side wins, and the winning operand is the value:
# && yields its left operand when that is falsy, || when it is truthy.
print(1 && 0)
print(1 || 0)
print(0 || 1)

# Truthiness with strings, same rule (the third line prints an empty string).
print("hello" && "")
print("" || "hello")
print(Bool("hello" && ""))

# Compound expressions
print((1 && 0) || true)
print(!false && true)
print(!true || !false)

# Bool constructor
print(Bool(1))
print(Bool(0))
print(Bool("hello"))
print(Bool(""))
print(Bool(nil))
print(Bool())

# && binds tighter than ||
print(true || false && false)
print(false && false || true)
print(1 == 1 || 2 == 3 && 4 == 5)
