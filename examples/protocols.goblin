# User-defined types can customize built-in protocols by defining methods with
# conventional __-prefixed names: operators (__add/__sub/...), comparison
# (__cmp), string and truthiness conversion (__str/__bool), iteration (__iter),
# and indexing (__getitem/__setitem).

type Vector(x, y) {
    func __add(self, other) {
        return Vector(self.x + other.x, self.y + other.y)
    }
    func __sub(self, other) {
        return Vector(self.x - other.x, self.y - other.y)
    }
    # __cmp returns -1, 0 or 1; it powers ==, !=, <, >, <=, >=
    func __cmp(self, other) {
        var a = self.x + self.y
        var b = other.x + other.y
        if a < b {
            return -1
        }
        if a > b {
            return 1
        }
        return 0
    }
    func __str(self) {
        return "Vector(" + Str(self.x) + ", " + Str(self.y) + ")"
    }
}

var v = Vector(1, 2)
var w = Vector(3, 4)

print(v + w)
print(w - v)
print(v)

print(v == v)
print(v == w)
print(v < w)
print(v > w)
print(v <= w)

# A type that opts into iteration and indexing.
type Grid(cells) {
    func __getitem(self, i) {
        return self.cells[i]
    }
    func __setitem(self, i, value) {
        self.cells[i] = value
    }
    func __iter(self) {
        return self.cells
    }
    func size(self) {
        return self.cells.size()
    }
}

var g = Grid([10, 20, 30])
print(g[0])
g[1] = 99
print(g[1])
for x in g {
    print(x)
}
print(g.size())

# A type that defines none of these protocols keeps the defaults: it is always
# truthy, so it takes the `if` branch here.
type Opaque() {
}
var o = Opaque()
if o {
    print("opaque is truthy")
}
# Without __not, ! negates truthiness.
print(!o)

# Reflected operators (__radd/__rsub/__rmul/__rdiv) run when the value is on
# the right of an operand that does not know it, which is the only way an
# expression like `1 + scaled` can reach a custom type. Comparison needs no
# such method: __cmp is already consulted from either side.
type Scaled(factor) {
    func __mul(self, other) {
        return Scaled(self.factor * other)
    }
    func __rmul(self, other) {
        return Scaled(other * self.factor)
    }
    func __radd(self, other) {
        return Scaled(other + self.factor)
    }
    func __rdiv(self, other) {
        return Scaled(other / self.factor)
    }
    func __str(self) {
        return "Scaled(" + Str(self.factor) + ")"
    }
}

var s = Scaled(3)
print(s * 2)
print(2 * s)
print(10 + s)
print(12 / s)
# Without __rsub the subtraction is still reported by its left operand.
try {
    print(1 - s)
} catch e {
    print(e)
}

# Repetition of the built-in sequences reads in either operand order too.
print("ab" * 3)
print(3 * "ab")
print([1, 2] * 2)
print(2 * [1, 2])
