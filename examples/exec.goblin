import "exec"
import "fs"
import "time"

# Run a step; the program stops with an error if it fails.
var step = exec.run(["sh", "-c", "echo building"])
print(step, step.code, step.success, step.stdout)
exec.run(["sh", "-c", "echo CI=$CI in $(basename $(pwd))"], cwd="fs_dir_fixture", env={"CI": "1"})

# Get a command's output as text.
var greeting = exec.capture(["sh", "-c", "echo hello from exec"]).stdout.trim()
print(greeting)
var words = exec.capture(["printf", "b\\na\\nb\\n"]).stdout.lines()
print(words)

# Feed it input.
print(exec.capture(["sort", "-u"], stdin="b\na\nb\n").stdout.lines())
var fixture = fs.open("fs_fixture.txt")
defer fixture.close()
print(exec.capture(["cat"], stdin=fixture).stdout.trim())

# A failure you expect: look at the result instead of catching.
var diff = exec.run(["sh", "-c", "exit 1"], check=false)
if !diff.success {
    print("working tree is dirty (status {diff.code})")
}
# Positionally timeout comes before check, as in Command.wait and http.send.
print(exec.run(["sh", "-c", "exit 5"], nil, nil, nil, nil, nil, 30, false).code)
print(exec.capture(["sh", "-c", "echo hi; exit 6"], nil, nil, nil, 30, false).stdout.trim())
try {
    exec.capture(["sh", "-c", "echo 'fatal: not a git repository' >&2; exit 128"])
} catch e: exec.ExitError {
    print(e.message)
}

# A failure you want to report your own way: the error carries the facts.
try {
    exec.capture(["sh", "-c", "echo broken >&2; exit 3"])
} catch e: exec.ExitError {
    print(e.code, e.stderr.trim(), e.stdout == "")
}
try {
    exec.run(["sh", "-c", "exit 4"])
} catch e: exec.ExitError {
    print(e.code, e.stdout, e.stderr)
}
try {
    raise exec.ExitError("made by hand", code=9)
} catch e: exec.ExitError {
    print(e.message, e.code, e.is(IOError))
}

# Is the tool there at all.
print(exec.find("sh") != nil, exec.find("goblin-no-such-tool"))
try {
    exec.run(["goblin-no-such-tool"])
} catch e: exec.ExitError {
    print("not reached")
} catch e: NotExistError {
    print("not installed:", e.message.split(":")[0])
}
try {
    exec.run(["sh", "-c", "true"], cwd="no-such-dir")
} catch e: NotExistError {
    print(e.path, type_of(e.path) == fs.Path)
}

# Send output to a file.
var scratch = fs.mkdir_temp(prefix="goblin-exec-")
defer fs.remove(scratch, recursive=true)
var log = fs.open(scratch.join("build.log"), write=true)
exec.run(["sh", "-c", "echo compiling; echo warning >&2"], stdout=log, stderr=log)
log.close()
print(fs.read(scratch.join("build.log")).lines())

# Or to any value with a write(data) method.
type Collector(chunks) {
    func write(self, data) {
        self.chunks.push(data.decode())
        return data.size
    }
}
var collected = Collector([])
exec.run(["sh", "-c", "echo collected"], stdout=collected)
print(collected.chunks)

# Give up after a while.
try {
    exec.run(["sleep", "10"], timeout=0.1)
} catch e: TimeoutError {
    print(e.message, e.stdout, e.stderr)
}
try {
    exec.capture(["sh", "-c", "echo partial; exec sleep 10"], timeout=0.5)
} catch e: TimeoutError {
    print(e.stdout.trim(), e.stderr == "")
}

# Start a process, use it, stop it.
var server = exec.start(["sleep", "10"])
print(server.running, server.pid > 0, server.stdout)
server.kill()
var ended = server.wait(check=false)
print(ended.code, ended.success, server.running)

# Follow a long-running command line by line.
var tail = exec.start(["sh", "-c", "echo starting; echo READY; sleep 10"], stdout=exec.PIPE)
for line in tail.stdout {
    print("tail:", line)
    if line.contains("READY") {
        break
    }
}
tail.kill()
tail.wait(check=false)
tail.stdout.close()

# A started command that fails raises from wait(), as run() does; waiting
# again gives the same outcome, and check=false hands back the Result.
var build = exec.start(["sh", "-c", "echo line1; exit 7"], stdout=exec.PIPE)
for line in build.stdout {
    print("build:", line)
}
build.stdout.close()
for attempt in range(2) {
    try {
        build.wait()
        print("never reached")
    } catch e: exec.ExitError {
        print(e.message, e.code, e.stdout, e.stderr)
    }
}
print(build.wait(check=false).code)

# capture() returns text; output that is not UTF-8 is read as Bytes from a
# pipe instead.
try {
    exec.capture(["printf", "a\\377b"])
} catch e: ValueError {
    print(e.message)
}
var binary = exec.start(["printf", "a\\377b"], stdout=exec.PIPE)
print(binary.stdout.read(), binary.wait().success)
binary.stdout.close()
try {
    exec.capture(["sh", "-c", "printf 'a\\377b'; exit 2"])
} catch e: exec.ExitError {
    print(e.code, e.stdout)
}

# Talk to a process through pipes.
var cat = exec.start(["cat"], stdin=exec.PIPE, stdout=exec.PIPE)
cat.stdin.write("through a pipe\n")
cat.stdin.close()
print(cat.stdout.read_line(), cat.wait().success)
cat.stdout.close()

print(type_of(step) == exec.Result, type_of(cat) == exec.Command, attributes(exec).contains("Pipe"))
try {
    exec.run(["cat"], stdout=exec.PIPE)
} catch e {
    print(e)
}
