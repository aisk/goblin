import "./modules/shapes"

# impl connects a type to the language's syntax; everything else is an
# ordinary method.
type Stack(items) {
    impl Index {
        func get(self, i) {
            return self.items[self.items.size - 1 - i]
        }
    }
    impl Add {
        func add(self, other) {
            return Stack(self.items + other.items)
        }
    }
    # An ordinary method may share a protocol method's name: protocol
    # methods are never attributes of the instance.
    func get(self) {
        return self.items[-1]
    }
    func add(self, item) {
        self.items.push(item)
        return self
    }
}

var s = Stack([1, 2])
print(s[0], s[1], s.get())
print(s.add(3).items, (s + Stack([9])).items)
print(attributes(s))

# A user type may be called like a protocol; impl Show still means the
# protocol, because the name after impl is never looked up.
type Show(text) {
    impl Show {
        func show(self) {
            return "<{self.text}>"
        }
    }
}
var shown = Show("x")
print(Show("shown"), "{shown}")

# Types from another module keep their impls.
var small = shapes.Square(2)
var big = shapes.Square(3)
print(small.describe(), big.area())
print(small < big, max(big, small), small == shapes.Square(2))
var counts = {small: 1}
print(counts[shapes.Square(2)])

# Methods backing operators must return the right type.
type Liar() {
    impl Show {
        func show(self) {
            return 42
        }
    }
    impl Eq {
        func eq(self, other) {
            return "yes"
        }
    }
}
try {
    print(Liar())
} catch e {
    print(e, e.is(TypeError))
}
try {
    print(Liar() == 1)
} catch e {
    print(e)
}

# Types are bound when the module loads, so a function can build a value
# before the type statement is reached.
func early() {
    return Pair(1, 2)
}
var first = early()
print(first, first == Pair(1, 2))

# Field and parameter names never clash with what the compiler generates.
type Pair(Hash, v) {
    impl Eq {}
    impl Show {}
    impl Add {
        func add(self, p) {
            return Pair(self.Hash + p.Hash, self.v + p.v)
        }
    }
}
print(Pair(1, 2) + Pair(3, 4))

# A user type named like a built-in one is not the built-in type.
type String(text) {}
type Impostor() {
    impl Show {
        func show(self) {
            return String("fake")
        }
    }
}
try {
    print(Impostor())
} catch e {
    print(e)
}
