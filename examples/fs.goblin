import "fs"
import "time"

# A scratch directory for this run, removed however the program ends.
var scratch = fs.mkdir_temp(prefix="goblin-fs-")
defer fs.remove(scratch, recursive=true)
print(scratch.name.has_prefix("goblin-fs-"), fs.is_dir(scratch))

# Read and write whole files.
var text = fs.read("fs_fixture.txt")
print(text.trim())
var copy = scratch.join("copy.txt")
fs.write(copy, text)
fs.write(copy, "started\n", append=true)
print(fs.read(copy).lines())
print(fs.read_bytes("fs_fixture.txt").size)

# A big file, one line at a time; the file is closed when the loop ends.
var started = 0
for line in fs.read_lines(copy) {
    if line.contains("started") {
        started = started + 1
    }
}
print("started lines:", started)
for line in fs.read_lines(copy) {
    print("first line:", line)
    break
}

# Build and take apart names (no disk access).
var source = fs.Path("docs/guide.md")
print(source.name, source.stem, source.suffix)
var target = fs.Path("build").join(source.with_suffix(".html").name)
print(target, target.parent, target.is_absolute)
print(fs.Path("a//b/../c.txt"), fs.Path("x/report.tar.gz").stem)
print(fs.Path("/srv/www/index.html").relative_to("/srv"))
print(fs.Path("a") == fs.Path("a/"), fs.Path("a") == "a", String(fs.Path("a")) == "a")
print(type_of(source) == fs.Path)

# Make sure the output directory is there, then write into it.
var page = scratch.join(target)
fs.mkdir(page.parent)
fs.write(page, "<h1>{text.trim()}</h1>")
print(fs.read(page))

# List, match, walk.
for entry in fs.read_dir("fs_dir_fixture") {
    print(entry, entry.name, fs.stat(entry).size)
}
fs.mkdir(scratch.join("docs", "guide"))
fs.write(scratch.join("docs", "intro.md"), "intro")
fs.write(scratch.join("docs", "guide", "setup.md"), "setup")
fs.write(scratch.join("docs", "guide", "notes.txt"), "notes")
fs.mkdir(scratch.join(".cache"))
fs.write(scratch.join(".cache", "hidden.md"), "hidden")
for found in fs.glob(String(scratch.join("docs", "**", "*.md"))) {
    print("glob:", found.relative_to(scratch))
}
func hidden(entry) {
    return entry.name.has_prefix(".")
}
for file in fs.walk(scratch, skip=hidden) {
    print("walk:", file.relative_to(scratch))
}

# Write a file piece by piece.
var rows = [["name", "size"], ["alpha", 6], ["beta", 5]]
var out = fs.open(scratch.join("big.csv"), write=true)
for row in rows {
    out.write("{row[0]},{row[1]}\n")
}
out.close()
print(out.closed, type_of(out) == fs.File)
var csv = fs.open(scratch.join("big.csv"))
print(csv.read_line(), csv.read(4))
for line in csv {
    print("rest:", line)
}
print(csv.read_line())
csv.close()

# Copy, move, delete, permissions.
var config = scratch.join("config.toml")
fs.write(config, "debug = true\n")
fs.copy(config, scratch.join("config.toml.bak"))
fs.move(copy, scratch.join("docs", "copy.txt"))
fs.remove(scratch.join("config.toml.bak"))
fs.remove(scratch.join("never-existed.log"))
fs.chmod(config, 0o600)
print(fs.stat(config).mode == 0o600, fs.exists(copy), fs.is_file(scratch.join("docs", "copy.txt")))
fs.copy(scratch.join("docs"), scratch.join("docs-backup"))
print(fs.read_dir(scratch.join("docs-backup")).map(func(p) { return p.name }))

# Is it there, how old is it.
if fs.exists(config) {
    var info = fs.stat(config)
    var age = time.now() - info.modified_at
    print(info.size, info.is_file, info.is_dir, info.is_symlink, age >= 0, age < 3600)
}

# Failures keep their kind and name the path.
func failure(f) {
    try {
        f()
    } catch e {
        print(e.message.replace(String(scratch), "<scratch>"))
    }
}
failure(func() { fs.read("missing.txt") })
failure(func() { fs.remove(scratch.join("docs")) })
failure(func() { fs.copy(scratch.join("docs"), scratch.join("docs-backup")) })
fs.mkdir(scratch.join("site/build"))
failure(func() { fs.copy(scratch.join("site"), scratch.join("site/build/out")) })
print(fs.exists(scratch.join("site/build/out")))
failure(func() { fs.Path("a").with_suffix("txt") })
failure(func() { fs.File() })
try {
    fs.stat("missing.txt")
} catch e: NotExistError {
    print(e.path, e.path.name, type_of(e.path) == fs.Path, e.is(IOError))
}

# The path is still there after the error is wrapped on its way up.
func load(path) {
    try {
        return fs.read(path)
    } catch e {
        raise e.wrap("loading settings")
    }
}
try {
    load(scratch.join("settings.toml"))
} catch e: NotExistError {
    print(e.message.replace(String(scratch), "<scratch>"), e.path.name)
}
fs.write(scratch.join("bad.txt"), Bytes("ok\n") + Bytes([255]) + Bytes("\n"))
try {
    for line in fs.read_lines(scratch.join("bad.txt")) {
        print(line)
    }
} catch e: ValueError {
    print(e.path.name, e.line)
}
# Collecting a lazy value into a List raises what the iteration raised.
try {
    List(fs.read_lines(scratch.join("nope.txt")))
} catch e: NotExistError {
    print(e.path.name, e.is(TypeError))
}
