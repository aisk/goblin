var numbers = [10, 20, 30, 40, 50]
print(numbers[1:3])
print(numbers[:2])
print(numbers[3:])
print(numbers[:])
print(numbers[2:2])
print(numbers[0:numbers.size])

# A slice is a copy: changing it leaves the original alone.
var head = numbers[:2]
head[0] = 99
head.push(100)
print(head, numbers)

# Bounds are ordinary expressions, and a slice can be sliced or indexed again.
var start = 1
print(numbers[start:start + 2])
print(numbers[1:4][1:])
print(numbers[1:4][0])
print(numbers[
    1:3
])

# A negative bound counts from the end.
print(numbers[-2:], numbers[:-1], numbers[-3:-1])

# Strings count characters, not bytes.
var text = "héllo, wörld"
print(text[:5])
print(text[7:])
print(text[1:2])
print(text[4:4] == "")
print("goblin"[2:].upper())

var raw = Bytes("goblin")
print(raw[:2])
print(raw[2:])

func middle(values) {
    return values[1:values.size - 1]
}
print(middle([1, 2, 3, 4]))
print(middle("abcd"))

# A slice takes what exists between its ends: an end past either end of the
# value stops there, and a low end past the high one gives an empty value.
var scores = [95, 70]
print(scores[:3], scores[-10:], numbers[2:9], numbers[3:1], numbers[-6:])
print(text[:99], "short line"[:80], raw[4:100], raw[10:])

# A bound must still be an Int, and only sequences can be sliced.
func attempt(action) {
    try {
        action()
    } catch err {
        print(err.is(IndexError), err.is(TypeError), err.message)
    }
}
attempt(func() { print(numbers["a":]) })
attempt(func() { print(numbers[:1.5]) })
attempt(func() { print({"a": 1}[0:1]) })
attempt(func() { print(42[:]) })
