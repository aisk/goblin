var numbers = [10, 20, 30, 40, 50]
print(numbers[1:3])
print(numbers[:2])
print(numbers[3:])
print(numbers[:])
print(numbers[2:2])
print(numbers[0:numbers.size])

# A slice is a copy: changing it leaves the original alone.
var head = numbers[:2]
head[0] = 99
head.push(100)
print(head, numbers)

# Bounds are ordinary expressions, and a slice can be sliced or indexed again.
var start = 1
print(numbers[start:start + 2])
print(numbers[1:4][1:])
print(numbers[1:4][0])
print(numbers[
    1:3
])

# Strings count characters, not bytes.
var text = "héllo, wörld"
print(text[:5])
print(text[7:])
print(text[1:2])
print(text[4:4] == "")
print("goblin"[2:].upper())

var raw = Bytes("goblin")
print(raw[:2])
print(raw[2:])

func middle(values) {
    return values[1:values.size - 1]
}
print(middle([1, 2, 3, 4]))
print(middle("abcd"))

# Bounds follow direct indexing: out of range is an IndexError.
func attempt(action) {
    try {
        action()
    } catch err {
        print(err.is(IndexError), err.is(TypeError), err.message)
    }
}
attempt(func() { print(numbers[2:9]) })
attempt(func() { print(numbers[3:1]) })
attempt(func() { print(numbers[-1:]) })
attempt(func() { print(text[:99]) })
attempt(func() { print(numbers["a":]) })
attempt(func() { print(numbers[:1.5]) })
attempt(func() { print({"a": 1}[0:1]) })
attempt(func() { print(42[:]) })
