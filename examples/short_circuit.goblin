# Short-circuit evaluation: && and || skip the RHS when the LHS already
# determines the result, so side effects in the skipped operand never run.

func boom() {
    print("boom ran")
    return true
}

# && short-circuits on a false LHS: boom() must not run.
print(false && boom())
# || short-circuits on a true LHS: boom() must not run.
print(true || boom())

# When the LHS leaves the result open, the RHS is evaluated.
print(true && boom())
print(false || boom())

# The value of the expression is the operand that decided it, not a Bool, so
# || reads as "use this, or a default" and && as "guard, then value".
print(0 && 1)
print(1 || 0)
print("" || "y")

var name = nil
print(name || "anonymous")

var configured = "custom"
print(configured || "anonymous")

var enabled = true
print(enabled && "feature on")

# Wrap in Bool() when a plain true/false is what you want.
print(Bool("x" && ""))
