# Digest and checksum modules: hmac, crc64, fnv, md5, sha1, crc32, adler32.
import "x/crypto/hmac"
import "x/hash/crc64"
import "x/hash/fnv"
import "x/crypto/md5"
import "x/crypto/sha1"
import "x/hash/crc32"
import "x/hash/adler32"

print(hmac.hex("key", "The quick brown fox jumps over the lazy dog"))
print(crc64.hex("123456789"))
print(crc64.hex("123456789", polynomial=crc64.ISO))
print(fnv.hex("hello"))
print(fnv.hex("hello", variant=fnv.FNV_32A))
print(md5.hex("Goblin"))
print(sha1.hex("Goblin"))
print(crc32.checksum("Goblin"))
print(adler32.checksum("Goblin"))
