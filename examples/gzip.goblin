import "exec"
import "gzip"
import "fs"
import "json"

var scratch = fs.mkdir_temp(prefix="goblin-gzip-")
defer fs.remove(scratch, recursive=true)

# Read a compressed export
var events_file = scratch.join("events.json.gz")
fs.write(events_file, gzip.compress(`{"event": "start"}` + "\n" + `{"event": "stop"}` + "\n"))
var text = gzip.decompress(fs.read_bytes(events_file)).decode()
for line in text.lines() {
    print(json.decode(line)["event"])
}

# A compressed file can also be read straight from the open file
var file = fs.open(events_file)
print(gzip.decompress(file).size)
file.close()

# Compress before uploading
var records = [{"id": 1}, {"id": 2}]
var body = gzip.compress(json.encode(records))
var headers = {"Content-Encoding": "gzip", "Content-Type": "application/json"}
print(body[0], body[1], gzip.decompress(body).decode())

# Compress a file
var log = scratch.join("app.log")
fs.write(log, "GET /index.html 200\n" * 1000)
fs.write(scratch.join("app.log.gz"), gzip.compress(fs.read_bytes(log), level=9))
print(fs.stat(log).size, fs.stat(scratch.join("app.log.gz")).size < 200)
print(gzip.decompress(fs.read_bytes(scratch.join("app.log.gz"))) == fs.read_bytes(log))

# Levels 1 (fastest) to 9 (smallest); nil is the usual balance
var data = "goblin " * 500
print(gzip.decompress(gzip.compress(data, level=1)).decode() == data)
print(gzip.decompress(gzip.compress(data, level=nil)).decode() == data)

# Several members one after another decompress as one; empty data round-trips
print(gzip.decompress(gzip.compress("one ") + gzip.compress("two")).decode())
print(gzip.decompress(gzip.compress("")))

# A compressed export of any size, one line at a time
var errors = 0
var jsonl = scratch.join("events.jsonl.gz")
var events = gzip.open(jsonl, write=true)
for level in ["info", "error", "info", "error", "error"] {
    events.write(json.encode({"level": level}) + "\n")
}
events.close()
for line in gzip.read_lines(jsonl) {
    if json.decode(line)["level"] == "error" {
        errors = errors + 1
    }
}
print("errors:", errors, type_of(gzip.read_lines(jsonl)) == fs.Lines)

# A small one, whole
fs.write(scratch.join("config.json.gz"), gzip.compress(`{"debug": true}`))
var config = json.decode(gzip.decompress(fs.read_bytes(scratch.join("config.json.gz"))))
print(config)

# Write a compressed file piece by piece
var report = scratch.join("report.csv.gz")
var out = gzip.open(report, write=true)
print(String(out).replace(String(scratch), "<scratch>"), type_of(out) == fs.File, out.path == report)
for row in ["id,name", "1,ada", "2,grace"] {
    print(out.write("{row}\n"))
}
out.close()
print(gzip.decompress(fs.read_bytes(report)).decode().lines())

# Compress a big log without holding it
var big_log = scratch.join("big.log")
fs.write(big_log, "GET /index.html 200\n" * 2000)
var packed_log = gzip.open(scratch.join("big.log.gz"), write=true, level=9)
for line in fs.read_lines(big_log) {
    packed_log.write("{line}\n")
}
packed_log.close()
print(fs.stat(scratch.join("big.log.gz")).size < 500)

# Unpack to disk without holding it
var source = gzip.open(scratch.join("big.log.gz"))
fs.write(scratch.join("unpacked.log"), source)
source.close()
print(fs.read(scratch.join("unpacked.log")) == fs.read(big_log), source.closed)

# Read a .gz File like any File
var reading = gzip.open(report)
print(reading.read_line(), reading.read(6))
for line in reading {
    print("rest:", line)
}
reading.close()

# Compress a command's output as it is produced
var dump = gzip.open(scratch.join("listing.txt.gz"), write=true)
exec.run(["printf", "a\\nb\\n"], stdout=dump)
dump.close()
print(List(gzip.read_lines(scratch.join("listing.txt.gz"))))

# Errors
for level in [0, 10] {
    try {
        gzip.compress("x", level=level)
    } catch e: ValueError {
        print(e)
    }
}
var packed = gzip.compress("hello, Goblin")
for bad in [Bytes(""), Bytes("plain text"), packed[:packed.size - 4]] {
    try {
        gzip.decompress(bad)
    } catch e: ParseError {
        print(e)
    }
}
try {
    gzip.decompress("text is not gzip data")
} catch e: TypeError {
    print(e)
}
try {
    gzip.open(scratch.join("x.gz"), level=5)
} catch e: ValueError {
    print(e)
}
try {
    gzip.open(report.with_suffix(".missing"))
} catch e: NotExistError {
    print(e.path.name)
}
try {
    for line in gzip.read_lines(big_log) {
        print("not reached")
    }
} catch e: ParseError {
    print(e.message.replace(String(scratch), "<scratch>"), e.path.name)
}
