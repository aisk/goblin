# Modulo operator tests

# Integer modulo
print(10 % 3)          # 1
print(7 % 2)           # 1
print(8 % 4)           # 0
print(1 % 5)           # 1
print(-7 % 3)          # -1
print(7 % -3)          # 1

# Float modulo
print(10.5 % 3.0)      # 1.5
print(7.0 % 2.0)       # 1
print(10.0 % 3.5)      # 3

# Mixed int/float modulo
print(10 % 3.5)        # 3
print(10.5 % 3)        # 1.5

# Modulo in expressions
var x = 17
print(x % 5)           # 2
print(100 % 7)         # 2

# Modulo precedence (same as * and /)
print(2 + 10 % 3)      # 3
print(10 % 3 * 2)      # 2

# Custom and reflected modulo protocols
type Cycle(size) {
    func __mod(self, other) {
        return self.size % other
    }
    func __rmod(self, other) {
        return other % self.size
    }
}
var cycle = Cycle(4)
print(cycle % 3)        # 1
print(10 % cycle)       # 2

# Modulo by either numeric zero is catchable
try {
    print(1 % 0)
} catch e {
    print(e.is(ZeroDivisionError))
}
try {
    print(1.0 % 0.0)
} catch e {
    print(e.is(ZeroDivisionError))
}
