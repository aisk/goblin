import "base32"
import "ascii85"
import "html"
import "quotedprintable"
import "md5"
import "sha1"
import "crc32"
import "adler32"
import "flate"
import "bzip2"
import "mail"

var encoded32 = base32.encode("Goblin", padding=false)
print(encoded32)
print(base32.decode(encoded32, padding=false).decode())

var encoded85 = ascii85.encode("Goblin")
print(encoded85)
print(ascii85.decode(encoded85).decode())

print(html.escape("<Goblin & Go>"))
print(html.unescape("&lt;Goblin&gt;"))

var quoted = quotedprintable.encode("Goblin = Go")
print(quoted)
print(quotedprintable.decode(quoted).decode())

print(md5.hex("Goblin"))
print(sha1.hex("Goblin"))
print(crc32.checksum("Goblin"))
print(adler32.checksum("Goblin"))

print(flate.decompress(flate.compress("Goblin compression")).decode())
var bzip_data = Bytes([66, 90, 104, 57, 49, 65, 89, 38, 83, 89, 242, 96, 229, 101, 0, 0, 0, 149, 128, 64, 0, 0, 128, 26, 39, 216, 0, 32, 0, 34, 152, 6, 141, 8, 6, 128, 47, 193, 116, 26, 140, 75, 13, 166, 143, 11, 185, 34, 156, 40, 72, 121, 48, 114, 178, 128])
print(bzip2.decompress(bzip_data).decode())

var address = mail.parse_address("Goblin <goblin@example.com>")
print(address.name)
print(address.address)
print(mail.parse_address_list("a@example.com, b@example.com").size())
