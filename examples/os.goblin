import "os"

# getenv returns a string, or nil / the default= fallback when unset
print(type_of(os.getenv("HOME")) == String)
print(os.getenv("GOBLIN_UNSET_VAR_FOR_TEST") == nil)
print(os.getenv("GOBLIN_UNSET_VAR_FOR_TEST", default="fallback"))

# argv is the process command line: a non-empty list of strings
var args = os.argv()
print(type_of(args) == List)
print(args.size > 0)
print(type_of(args[0]) == String)

# process and user/group accessors return integers
print(type_of(os.getpid()) == Int)
print(type_of(os.getppid()) == Int)
print(type_of(os.getuid()) == Int)

# A live process always has a positive pid
print(os.getpid() > 0)

# Note: os.exit() is tested separately to avoid terminating the test runner

# tempdir / tempfile mirror Go's os.MkdirTemp / os.CreateTemp.
# Both dir and pattern are optional.
var d1 = os.tempdir()
print(d1 != "")

var d2 = os.tempdir("", "goblin-*")
print(d2 != "")

var f1 = os.tempfile()
print(f1 != "")

var f2 = os.tempfile("", "goblin-*")
print(f2 != "")
