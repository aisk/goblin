# Integer arithmetic
print(1 + 2)
print(10 - 3)
print(4 * 5)
print(10 / 2)
print(10 % 3)
print(7 % 2)
print(8 % 4)
print(1 % 5)
print(-7 % 3)
print(7 % -3)

# Operator precedence
print(1 + 2 * 3)
print((1 + 2) * 3)
print(2 + 10 % 3)
print(10 % 3 * 2)

# Float arithmetic
print(3.14)
print(2.5 + 1.5)
print(5.0 * 2.0)
print(10.0 / 2.0)
print(10.5 % 3.0)
print(7.0 % 2.0)
print(10.0 % 3.5)

# Mixed int/float
print(3.5 + 2)
print(10 / 2.5)
print(10 % 3.5)
print(10.5 % 3)

# Modulo in expressions
var x = 17
print(x % 5)
print(100 % 7)

# Custom and reflected modulo through Mod
type Cycle(size) {
    impl Mod {
        func mod(self, other) {
            return self.size % other
        }
        func rmod(self, other) {
            return other % self.size
        }
    }
}
var cycle = Cycle(4)
print(cycle % 3)
print(10 % cycle)

# Modulo by either numeric zero is catchable
try {
    print(1 % 0)
} catch e {
    print(e.is(ZeroDivisionError))
}
try {
    print(1.0 % 0.0)
} catch e {
    print(e.is(ZeroDivisionError))
}

# Unary plus/minus
print(+1)
print(-1)
print(+1.5)
print(-1.5)
print(--1)
print(+-1)
print(-1 * 2)
print(-(1 + 2))

# Int constructor
print(Int(42))
print(Int(3.7))
print(Int("100"))
print(Int(true))
print(Int(false))
print(Int())

# Text in another base: digits only, letters in either case, an optional sign.
print(Int("ff", base=16), Int("FF8800", base=16), Int("755", base=8), Int("-101", base=2), Int("z", base=36))
var color = "#ff8800"
print(range(3).map(func(i) { return Int(color[1 + i * 2:3 + i * 2], base=16) }))
for bad in [func() { return Int("0xff", base=16) }, func() { return Int("12", base=1) }, func() { return Int(255, base=16) }] {
    try {
        bad()
    } catch e {
        print(e.is(ValueError), e.is(TypeError), e.message)
    }
}

# Float constructor
print(Float(3))
print(Float(3.14))
print(Float("2.5"))
print(Float(true))
print(Float())

# Unary + and - work on numbers only; anything else is a TypeError.
print(-7)
print(+7)
print(-2.5)
var negated = -(3 * 4)
print(negated)
try {
    print(-true)
} catch e {
    print(e.message)
}
try {
    print(+"text")
} catch e {
    print(e.message)
}
