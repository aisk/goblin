# Dict creation
var empty = {}
print(empty)

var d = {"name": "Alice", "age": 30}

# Dict indexing
print(d["name"])
print(d["age"])

# Dict value assignment: update existing and insert new key
var scores = {"a": 1, "b": 2}
scores["a"] = 100
scores["c"] = 3
print(scores["a"])
print(scores["b"])
print(scores["c"])
print(scores.size)

# Dict methods
print(d.size)
print(d.keys().size)
print(d.values().size)

# Dict iteration visits every key exactly once
var count = 0
for key in d {
    count = count + 1
}
print(count)

# Dict constructor
print(Dict(a=1))
print(Dict())

var options = {"host": "localhost"}
print(options.contains(key="host"))
print(options.get("port", default=8080))
print(options.get_or_set(key="port", default=3000))
print(options.get_or_set("port", 4000))
print(options.get("port"))
print(options.pop(key="port"))
print(options.get("port"))
options.update(other={"debug": true})
print(options.get("debug"))
print(options.items().size)
var options_copy = options.copy()
options_copy.clear()
print(options_copy.size)

# Keys of different types stay distinct
var mixed = {}
mixed[1] = "int key"
mixed["1"] = "string key"
print(mixed[1])
print(mixed["1"])
print(mixed.size)

# Key identity follows ==, so equal numbers are one key
var nums = {}
nums[1] = "first"
nums[1.0] = "second"
print(nums[1])
print(nums.size)

# Only immutable values can be keys
try {
    mixed[[1, 2]] = "boom"
} catch e {
    print(e)
}

# Values whose equality is identity hash by identity, so functions and error
# kinds can key a dispatch table
func greet() {
    return "hi"
}
var handlers = {greet: "greet", TypeError: "type"}
print(handlers[greet], handlers[TypeError])

# A dict remembers insertion order: keys(), values(), items(), copy(), for,
# printing and update() all follow it. Overwriting keeps a key's place;
# removing it and writing it again moves it to the end.
var order = {"b": 1, "a": 2}
order["c"] = 3
order["b"] = 10
print(order, order.keys(), order.values(), order.items())
print(order.remove("b").remove("missing"), order.size)
order["b"] = 20
print(order)
for key in order {
    print(key, order[key])
}
print(order.copy(), Dict(z=1, y=2), order.update({"a": 0, "d": 4}))
print(order.pop("a"), order)
print(order.clear(), order.size)

# Equality ignores order.
print({"x": 1, "y": 2} == {"y": 2, "x": 1})

# get_or_set needs a default; remove and update return the dict.
try {
    order.get_or_set("k")
} catch e {
    print(e)
}
var counts = {}
for word in ["a", "b", "a"] {
    counts.get_or_set(word, []).push(word)
}
print(counts)
