import "time"

# Parse a date from a string
var t = time.parse("2006-01-02", "2026-07-02")
print(t.year)
print(t.month)
print(t.day)
print(t.weekday)

# Format a time
print(t.format("2006/01/02"))

# Create time from Unix timestamp (epoch)
var epoch = time.unix(0)
print(epoch.year)

# Compare two times
var t1 = time.parse("2006-01-02", "2025-01-01")
var t2 = time.parse("2006-01-02", "2026-01-01")
print(t1 < t2)

# Construct a time from calendar components
var built = time.Time(2026, 7, 19, hour=9, minute=30)
print(built.format("2006-01-02 15:04"))
print(built.constructor == time.Time)

# Times are hashable, so equal instants are one dict key
var events = {time.Time(2026, 7, 19): "launch"}
print(events[time.Time(2026, 7, 19)])

# Arithmetic counts in seconds: shifting gives a Time, and the difference of
# two times is a Float number of seconds
var start = time.Time(2026, 7, 19, hour=9, minute=30)
print((start + 90).format("15:04:05"), (1.5 + start).format("15:04:05.000"))
print((start - 3600).hour)
print(start + 7200 - start)
try {
    print(start + "soon")
} catch e {
    print(e)
}
