# A module whose exported variables change after it has loaded. Every export
# is a live binding: importers read the variable as it is now.
var count = 0
var history = []

func bump(by=1) {
    count = count + by
    history.push(count)
    return count
}

func reset() {
    count = 0
}

type Tally(name) {
    func read(self) {
        return "{self.name}: {count}"
    }
}

export count
export history
export bump
export reset
export Tally

# Assigned after its export statement: importers see the final value.
var label = "draft"
export label
label = "final"

var ratio = 0.5
export ratio
ratio = ratio * 3.0

# A function name is a variable too; this export follows the assignment.
func describe() {
    return "first"
}
export describe
describe = func() { return "second" }
