# A module exporting a type with impls and ordinary methods.
type Square(side) {
    impl Eq {}
    impl Hashable {}
    impl Show {}
    impl Ord {
        func compare(self, other) {
            return self.side - other.side
        }
    }

    func area(self) {
        return self.side * self.side
    }

    func describe(self) {
        return "{self} has area {self.area()}"
    }
}

export Square
