# Executable coverage for API names and signatures used by short reference chapters.
import "csv"
import "hash"
import "base64"
import "gzip"

var rows = csv.decode("name,score\nAda,10\n")
csv.encode(rows, sep=";")
csv.encode(csv.decode_dicts("name,score\nAda,10\n"), columns=["score", "name"])

var source = "Goblin Goblin Goblin"
gzip.decompress(gzip.compress(source, level=1))
hash.hmac("key", source, algorithm=hash.sha512).to_hex()
hash.md5(Bytes(source)).to_hex()
base64.decode(base64.encode(source, url_safe=true, padding=false), url_safe=true)

func identity(value) {
    return value
}
Function(identity)
type_of(identity)
