_digit : '0'-'9' ;
int_lit : _digit { _digit } ;
float_lit : _digit { _digit } '.' _digit { _digit } ;

_alpha : 'a'-'z' | 'A'-'Z' | '_' ;
_alphanum : _alpha | _digit ;
id : _alpha { _alphanum } ;

_ascii_char
    : '\x01' - '\x21'
    | '\x23' - '\x5B'
    | '\x5D' - '\x7F'
;
_unicode_byte
    : '\u0080' - '\uFFFC'
    // skip invalid code point (\uFFFD)
    | '\uFFFE' - '\U0010FFFF'
;
_unicode_char
    : _ascii_char
    | _unicode_byte
;

_escaped_char : '\\' ( 'n' | 't' | 'r' | '"' | '\\' ) ;
_char         : _unicode_char | _escaped_char ;

string_lit : '"' { _char } '"' ;

// Newlines are significant: they terminate statements. Carriage returns are
// plain whitespace so CRLF sources work unchanged.
!whitespace : ' ' | '\t' | '\r' ;
newline : '\n' ;

// A comment runs to the end of its line and carries the newline with it, so
// the grammar treats it as a statement terminator. Every character except
// '\n' may appear in the body.
_comment_char
    : '\x01' - '\x09'
    | '\x0B' - '\uFFFC'
    | '\uFFFE' - '\U0010FFFF'
;
comment : '#' { _comment_char } '\n' ;


<< import (
    "github.com/aisk/goblin/ast"
) >>


Module
    : OptNewlines                                   << ast.NewModule(nil) >>
    | OptNewlines StatementList OptNewlines         << ast.NewModule($1) >>
;

// Terminator is anything that ends a source line. Newlines is one or more of
// them, so blank lines and comment-only lines collapse into one separator.
Terminator
    : newline
    | comment
;

Newlines
    : Terminator
    | Newlines Terminator
;

OptNewlines
    : empty
    | Newlines
;

StatementList
    : Statement                              << ast.NewStatementList($0) >>
    | StatementList Newlines Statement       << ast.AppendStatementList($0, $2) >>
;

Statement
    : Expression
    | Declare
    | Assign
    | If
    | While
    | For
    | Break
    | Continue
    | FunctionDefine
    | TypeDefine
    | TraitDefine
    | Return
    | Raise
    | Try
    | Export
    | Import
;

Import
    : "import" string_lit  << ast.NewImport($1) >>
;

// A line may continue onto the next one only after a binary operator, a
// comma, a colon, or an opening bracket. This keeps a newline after a
// complete expression unambiguous as a statement end.
Expression
    : OrExpression
;

OrExpression
    : AndExpression
    | OrExpression "||" OptNewlines AndExpression        << ast.NewBinaryOperation($0, "||", $3) >>
;

AndExpression
    : ComparisonExpression
    | AndExpression "&&" OptNewlines ComparisonExpression << ast.NewBinaryOperation($0, "&&", $3) >>
;

// Comparisons are non-associative: `a < b < c` is a parse error rather than
// the surprising `(a < b) < c`. Use explicit parentheses to compare a result.
ComparisonExpression
    : AdditiveExpression
    | AdditiveExpression "==" OptNewlines AdditiveExpression << ast.NewBinaryOperation($0, "==", $3) >>
    | AdditiveExpression "!=" OptNewlines AdditiveExpression << ast.NewBinaryOperation($0, "!=", $3) >>
    | AdditiveExpression "<=" OptNewlines AdditiveExpression << ast.NewBinaryOperation($0, "<=", $3) >>
    | AdditiveExpression ">=" OptNewlines AdditiveExpression << ast.NewBinaryOperation($0, ">=", $3) >>
    | AdditiveExpression "<" OptNewlines AdditiveExpression  << ast.NewBinaryOperation($0, "<", $3) >>
    | AdditiveExpression ">" OptNewlines AdditiveExpression  << ast.NewBinaryOperation($0, ">", $3) >>
;

AdditiveExpression
    : MultiplicativeExpression
    | AdditiveExpression "+" OptNewlines MultiplicativeExpression << ast.NewBinaryOperation($0, "+", $3) >>
    | AdditiveExpression "-" OptNewlines MultiplicativeExpression << ast.NewBinaryOperation($0, "-", $3) >>
;

MultiplicativeExpression
    : UnaryExpression
    | MultiplicativeExpression "*" OptNewlines UnaryExpression << ast.NewBinaryOperation($0, "*", $3) >>
    | MultiplicativeExpression "/" OptNewlines UnaryExpression << ast.NewBinaryOperation($0, "/", $3) >>
    | MultiplicativeExpression "%" OptNewlines UnaryExpression << ast.NewBinaryOperation($0, "%", $3) >>
;

UnaryExpression
    : PostfixExpression
    | "!" UnaryExpression                    << ast.NewUnaryOperation($0, $1) >>
    | "+" UnaryExpression                    << ast.NewUnaryOperation($0, $1) >>
    | "-" UnaryExpression                    << ast.NewUnaryOperation($0, $1) >>
;

PostfixExpression
    : PrimaryExpression
    | PostfixExpression "[" OptNewlines Expression OptNewlines "]"   << ast.NewIndexExpression($0, $3) >>
    | PostfixExpression "(" OptNewlines ")"                          << ast.NewCallExpression($0, nil) >>
    | PostfixExpression "(" OptNewlines ArgumentList OptNewlines ")" << ast.NewCallExpression($0, $3) >>
    | PostfixExpression "." id                                       << ast.NewMemberExpression($0, $2) >>
;

PrimaryExpression
    : IntegerLiteral
    | FloatLiteral
    | StringLiteral
    | TrueLiteral
    | FalseLiteral
    | NilLiteral
    | ListLiteral
    | DictLiteral
    | FunctionLiteral
    | id                                     << ast.NewIdentifier($0) >>
    | "(" OptNewlines Expression OptNewlines ")"   << $2, nil >>
;

FunctionLiteral
    : "func" Parameters Block                << ast.NewFunctionLiteral($0, $1, $2) >>
;

IntegerLiteral
    : int_lit                                << ast.NewIntegerLiteral($0) >>
;

FloatLiteral
    : float_lit                              << ast.NewFloatLiteral($0) >>;

StringLiteral
    : string_lit                             << ast.NewStringLiteral($0) >>
;

TrueLiteral
    : "true"                                 << ast.NewTrueLiteral() >>
;

FalseLiteral
    : "false"                                << ast.NewFalseLiteral() >>
;

NilLiteral
    : "nil"                                  << ast.NewNilLiteral() >>
;

ListLiteral
    : "[" OptNewlines "]"                                << ast.NewListLiteral(nil) >>
    | "[" OptNewlines ListElementList OptNewlines "]"    << ast.NewListLiteral($2) >>
;

ListElementList
    : Expression                                         << ast.NewExpressionList($0) >>
    | ListElementList "," OptNewlines Expression         << ast.AppendExpressionList($0, $3) >>
;

DictLiteral
    : "{" OptNewlines "}"                                << ast.NewDictLiteral(nil) >>
    | "{" OptNewlines DictElementList OptNewlines "}"    << ast.NewDictLiteral($2) >>
;

DictElementList
    : DictElement                                        << ast.NewDictElementList($0) >>
    | DictElementList "," OptNewlines DictElement        << ast.AppendDictElementList($0, $3) >>
;

DictElement
    : Expression ":" OptNewlines Expression              << ast.NewDictElement($0, $3) >>
;

ArgumentList
    : Argument                                           << ast.NewCallArgumentList($0) >>
    | ArgumentList "," OptNewlines Argument              << ast.AppendCallArgumentList($0, $3) >>
;

Argument
    : Expression                             << ast.NewPositionalArgument($0) >>
    | id "=" Expression                      << ast.NewKeywordArgument($0, $2) >>
    | "**" Expression                        << ast.NewKeywordUnpackArgument($1) >>
    | "*" Expression                         << ast.NewStarredArgument($1) >>
;

Declare
    : "var" id "=" Expression                << ast.NewDeclare($1, $3) >>
;

Assign
    : PostfixExpression "=" Expression       << ast.NewSetAssign($0, $2) >>
;

Block
    : "{" OptNewlines "}"                                << nil, nil >>
    | "{" OptNewlines StatementList OptNewlines "}"      << $2, nil >>
;

If
    : "if" Expression Block                  << ast.NewIf($1, $2, nil) >>
    | "if" Expression Block "else" Block     << ast.NewIf($1, $2, $4) >>
    | "if" Expression Block "else" If        << ast.NewIf($1, $2, $4) >>
;

While
    : "while" Expression Block               << ast.NewWhile($1, $2) >>
;

For
    : "for" id "in" Expression Block         << ast.NewFor($1, $3, $4) >>
;

Break
    : "break"                                << ast.NewBreak() >>
;

Continue
    : "continue"                             << ast.NewContinue() >>
;

// Parameters includes the parentheses so that newlines inside them can be
// accepted without an ambiguous run of two optional newline sequences.
Parameters
    : "(" OptNewlines ")"                                << nil, nil >>
    | "(" OptNewlines ParameterList OptNewlines ")"      << $2, nil >>
;

ParameterList
    : Parameter                                          << ast.NewParameterList($0) >>
    | ParameterList "," OptNewlines Parameter            << ast.AppendParameterList($0, $3) >>
;

Parameter
    : id                                     << ast.NewRequiredParameter($0) >>
    | id "=" Expression                      << ast.NewDefaultParameter($0, $2) >>
    | "*" id                                 << ast.NewVarArgsParameter($1) >>
    | "**" id                                << ast.NewKwArgsParameter($1) >>
;

TypeFields
    : "(" OptNewlines ")"                                << nil, nil >>
    | "(" OptNewlines TypeFieldList OptNewlines ")"      << $2, nil >>
;

TypeFieldList
    : TypeField                                          << ast.NewTypeFieldList($0) >>
    | TypeFieldList "," OptNewlines TypeField            << ast.AppendTypeFieldList($0, $3) >>
;

TypeField
    : id                                     << ast.NewRequiredTypeField($0) >>
    | id "=" Expression                      << ast.NewDefaultTypeField($0, $2) >>
;

FunctionDefine
    : "func" id Parameters Block             << ast.NewFunctionDefine($1, $2, $3) >>
;

TypeMethodList
    : FunctionDefine                                     << ast.NewTypeMethodList($0) >>
    | TypeMethodList Newlines FunctionDefine             << ast.AppendTypeMethodList($0, $2) >>
;

// A type body holds ordinary methods and impl blocks, in any order.
TypeBody
    : "{" OptNewlines "}"                                << nil, nil >>
    | "{" OptNewlines TypeMemberList OptNewlines "}"     << $2, nil >>
;

TypeMemberList
    : TypeMember                                         << ast.NewTypeMemberList($0) >>
    | TypeMemberList Newlines TypeMember                 << ast.AppendTypeMemberList($0, $2) >>
;

TypeMember
    : FunctionDefine
    | ImplBlock
;

ImplBlock
    : "impl" TraitRef "{" OptNewlines "}"                              << ast.NewImplBlock($1, nil) >>
    | "impl" TraitRef "{" OptNewlines TypeMethodList OptNewlines "}"   << ast.NewImplBlock($1, $4) >>
;

TraitRef
    : id                                     << ast.NewTraitRef(nil, $0) >>
    | id "." id                              << ast.NewTraitRef($0, $2) >>
;

TraitRefList
    : TraitRef                                           << ast.NewTraitRefList($0) >>
    | TraitRefList "," OptNewlines TraitRef              << ast.AppendTraitRefList($0, $3) >>
;

TypeDefine
    : "type" id TypeFields TypeBody          << ast.NewTypeDefine($1, $2, $3) >>
;

// A trait member without a body is a required method; one with a body is a
// default. The body-less form lives only here, so it stays a syntax error
// everywhere else.
TraitDefine
    : "trait" id TraitDeps "{" OptNewlines "}"                              << ast.NewTraitDefine($1, $2, nil) >>
    | "trait" id TraitDeps "{" OptNewlines TraitMemberList OptNewlines "}"  << ast.NewTraitDefine($1, $2, $5) >>
;

TraitDeps
    : empty                                  << nil, nil >>
    | ":" TraitRefList                       << $1, nil >>
;

TraitMemberList
    : TraitMember                                        << ast.NewTypeMethodList($0) >>
    | TraitMemberList Newlines TraitMember               << ast.AppendTypeMethodList($0, $2) >>
;

TraitMember
    : FunctionDefine
    | "func" id Parameters                   << ast.NewRequiredMethod($1, $2) >>
;

Return
    : "return" Expression                    << ast.NewReturn($1) >>
    | "return"                               << ast.NewReturnNil($0) >>
;

Raise
    : "raise" Expression                     << ast.NewRaise($1) >>
;

Try
    : "try" Block "catch" id Block           << ast.NewTryCatch($0, $1, $3, $4) >>
;

Export
    : "export" id                            << ast.NewExport($1) >>
;
